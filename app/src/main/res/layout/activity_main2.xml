<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Graywhite"
    android:clipChildren="false"
    android:clipToPadding="false"
    >

    <!-- 👇 모든 UI 뒤쪽 배경 레이어 (가장 먼저 선언해서 뒤에서 그려지게) -->
    <FrameLayout
        android:id="@+id/rippleHost"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="false"
        android:focusable="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- 상단 고정 헤더 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="24dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 러닝 제목 -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="러닝중"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />

        <!-- 도움말 아이콘 -->
        <ImageView
            android:id="@+id/iv_help"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ri_question_line" />
    </LinearLayout>

    <!-- 상단 구분선 -->
    <View
        android:id="@+id/header_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#D9D9D9"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- 상단 원형 카드 -->
    <FrameLayout
        android:id="@+id/circleStats"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:layout_margin="80dp"
        android:background="@drawable/running_background"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <!--        &lt;!&ndash; 퍼지는 링 애니메이션 (RippleBackground) &ndash;&gt;-->
        <!--        <com.skyfishjy.library.RippleBackground-->
        <!--            android:id="@+id/stepRipple"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="match_parent"-->
        <!--            android:elevation="8dp"-->
        <!--            app:rb_color="#7AA66B"-->
        <!--            app:rb_radius="250dp"-->
        <!--            app:rb_rippleAmount="1"-->
        <!--            app:rb_duration="800"-->
        <!--            app:rb_scale="10" />-->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="달린 거리"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:lineSpacingExtra="0dp"
                android:lineSpacingMultiplier="1"
                android:text="0.0"
                android:textColor="@android:color/white"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/distanceUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="km"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="달린 시간"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/timeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:text="00:00:00"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- 일시정지 버튼 (초기 표시됨) -->
                <ImageButton
                    android:id="@+id/pauseButton"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@null"
                    android:contentDescription="pause"
                    android:src="@drawable/button" />

                <!-- 일시정지 후 보여줄 버튼 그룹 (처음엔 안보임) -->
                <LinearLayout
                    android:id="@+id/pauseOptions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/resumeButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@null"
                        android:contentDescription="resume"
                        android:src="@drawable/play_button" />

                    <Space
                        android:layout_width="5dp"
                        android:layout_height="match_parent" />

                    <ImageButton
                        android:id="@+id/endButton"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@null"
                        android:contentDescription="end"
                        android:src="@drawable/stop_button" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>

    <!--        android:background="@drawable/running"-->
<!--        app:layout_constraintWidth_percent="0.5"/>-->

    <!-- 하단 두 박스를 감싸는 부모 레이아웃 -->
    <LinearLayout
        android:id="@+id/bottomStatsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="37dp"
        android:layout_marginTop="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/BC_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/circleStats"
        app:layout_constraintWidth_percent="0.5">

        <!-- 왼쪽 하단 박스 (평균 케이던스) -->
        <!-- 평균 케이던스 박스 -->
        <LinearLayout
            android:id="@+id/cadenceBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_white_box"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/TextAvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="예측 케이던스"
                android:textColor="#666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/TextAvgNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="---"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="spm"
                android:textSize="12sp" />

            <!-- 텍스트들 추가 -->
        </LinearLayout>

        <!-- 소비 칼로리 박스 -->
        <LinearLayout
            android:id="@+id/calorieBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/rounded_white_box"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="소비 칼로리"
                android:textColor="#666"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/calorieText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kcal"
                android:textSize="12sp" />
            <!-- 텍스트들 추가 -->
        </LinearLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/BC_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/musicContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bottomStatsContainer">

        <FrameLayout
            android:id="@+id/cadenceFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_cadence_green"
            android:layout_marginBottom="5dp">

        </FrameLayout>

        <FrameLayout
            android:id="@+id/breathFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_breath_red">

        </FrameLayout>

    </LinearLayout>


    <!-- 하단 노래 재생 웹뷰 -->
    <LinearLayout
        android:id="@+id/musicContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/BC_box"
        app:layout_constraintWidth_percent="0.5"
        android:minHeight="300dp">

        <!-- 중간에 WebView만 포함 -->

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_weight="1" />

    </LinearLayout>
