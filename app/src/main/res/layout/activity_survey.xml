<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvTitle"
        android:text="선호 조사 1/5"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/tvMeta"
        android:text="노래 제목 - 가수"
        android:layout_marginTop="8dp"
        android:textSize="16sp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <WebView
        android:id="@+id/webPlayer"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"/>


    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnPrev"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="이전 곡"
            app:layout_constraintEnd_toStartOf="@+id/btnSkip"
            app:layout_constraintBaseline_toBaselineOf="@+id/btnSkip"
            android:backgroundTint="#C97F7F"/>

        <Button
            android:id="@+id/btnLike"
            android:text="좋아요"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#8CC97F"/>

        <Button
            android:id="@+id/btnDislike"
            android:text="싫어요"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#8CC97F"/>

<!--        <Button-->
<!--            android:id="@+id/btnSkip"-->
<!--            android:text="건너뛰기"-->
<!--            android:layout_weight="1"-->
<!--            android:layout_width="0dp"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:backgroundTint="#8CC97F"/>-->


    </LinearLayout>



    <Button
        android:id="@+id/btnSubmitAll"
        android:text="모두 제출"
        android:layout_marginTop="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#8CC97F"/>




    <ProgressBar
        android:id="@+id/progress"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
