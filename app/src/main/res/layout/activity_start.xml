<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:padding="24dp">

    <!-- 중앙 로고 -->
<!--    <ImageView-->
<!--        android:id="@+id/imageLogo"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:src="@drawable/logo_temrun"-->
<!--        android:layout_marginBottom="0dp" />-->

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Spotify로 시작하기 버튼 -->
    <Button
        android:id="@+id/btnStartSpotify"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Spotify로 시작하기"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:backgroundTint="#1ED760"
        android:drawableStart="@drawable/ic_spotify_logo"
        android:drawablePadding="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- 로그인 링크 -->
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="이미 계정이 있나요?"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginEnd="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvLogin"
            android:text="로그인"
            android:textColor="#4EACF0"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
