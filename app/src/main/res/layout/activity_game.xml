<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    android:clipChildren="false">

    <!-- 상단 정보 카드 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topInfoContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="20sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 아래 여백 가이드 (하단 영역 높이 비슷하게 확보) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_end="114dp" />

    <!-- 좌측 세로 진행바 -->
    <FrameLayout
        android:id="@+id/verticalBarContainer"
        android:layout_width="10dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topInfoContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomGuide"
        app:layout_constraintStart_toStartOf="parent"
        android:elevation="10dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <View
            android:id="@+id/verticalProgressFill"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:background="#8CC97F" />
    </FrameLayout>

    <!-- 게임 영역 루트: ConstraintLayout (중앙 영역 전부 담음) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/topInfoContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/verticalBarContainer"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 리듬 영역(바 내려오는 곳) -->
        <FrameLayout
            android:id="@+id/rhythmZone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#00000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- 폭 제한 래퍼 (중앙 정렬) -->
            <FrameLayout
                android:id="@+id/rhythmBarContainer"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false" />
        </FrameLayout>

        <!-- 판정선: 하단에서 140dp 위 -->
        <View
            android:id="@+id/judgementLine"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_marginBottom="143dp"
            android:background="#7E95D188"
            android:elevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- 판정 배지(이미지) : 판정선에 세로 중앙 + 가로 중앙 -->
        <ImageView
            android:id="@+id/judgementBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:contentDescription="@null"
            app:layout_constraintTop_toTopOf="@id/judgementLine"
            app:layout_constraintBottom_toBottomOf="@id/judgementLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:translationY="-30dp"
            android:elevation="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 하단 악기/게이지 영역 -->
    <LinearLayout
        android:id="@+id/bottomZone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:clipChildren="false"
        android:elevation="10dp"
        app:layout_constraintStart_toEndOf="@id/verticalBarContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/instrument1"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_margin="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/guitar_gauge" />

        <ImageView
            android:id="@+id/instrument2"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/drum_gauge" />

        <ImageView
            android:id="@+id/instrument3"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/piano_gauge" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
